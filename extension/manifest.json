{
  "manifest_version": 3,
  "name": "tabshot",
  "version": "0.3.0",
  "description": "Lets a local CLI photograph allow-listed tabs and click, type, scroll in them. Never hands over page text, cookies or URLs.",
  "homepage_url": "https://github.com/faradey/tabshot",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "tabs", "scripting", "storage", "alarms", "webNavigation", "debugger"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["*://*/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": {
    "default_title": "tabshot: share this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
